# ---- LLM（任意 OpenAI 兼容端点）----
# 四个编排角色：manager / planner / worker / compactor
PI_BASE_URL=http://127.0.0.1:8787/v1
PI_API_KEY=sk-local-mock
PI_MODEL_ID=mock-pentest-model
PI_CONTEXT_WINDOW=256000
PI_MAX_TOKENS=126000
# off | minimal | low | medium | high | xhigh | max；不设或 off 不发送思考档位
# PI_THINKING_LEVEL=high

# ---- 角色级覆盖（可选；未设置则沿用全局值）----
# PI_BASE_URL_MANAGER=   PI_API_KEY_MANAGER=   PI_MODEL_ID_MANAGER=
# PI_BASE_URL_PLANNER=   PI_API_KEY_PLANNER=   PI_MODEL_ID_PLANNER=
# PI_BASE_URL_WORKER=    PI_API_KEY_WORKER=    PI_MODEL_ID_WORKER=
# PI_BASE_URL_COMPACTOR= PI_API_KEY_COMPACTOR= PI_MODEL_ID_COMPACTOR=
# PI_CONTEXT_WINDOW_PLANNER=512000
# PI_MAX_TOKENS_PLANNER=126000
# PI_CONTEXT_WINDOW_WORKER=256000
# PI_MAX_TOKENS_WORKER=64000
# PI_THINKING_LEVEL_PLANNER=high
# PI_THINKING_LEVEL_WORKER=low
# PI_THINKING_LEVEL_COMPACTOR=low

# ---- 运行模式与产物目录 ----
# container：宿主机编排器 + Docker PostgreSQL/Kali（现有开发模式）。
# embedded：All-in-One 本容器直接执行工具，不调用 Docker、不在启动时安装。
KALI_RUNTIME=container
# 相对路径按项目根解析；默认保持 report/history_db/workspaces 原位。
# All-in-One 镜像默认覆盖为 /output。
PARAM_OUTPUT_DIR=.
# 无显式命令行参数时，可读取提示词文件和 CTF_INPUT；两者共存时文件在前、env 在后。
# 本地默认 input/ctf.txt；All-in-One 默认 /input/ctf.txt。
# CTF_INPUT_FILE=input/ctf.txt
# CTF_INPUT=

# ---- CTF 并发 ----
# 同时 active 的赛题数，也是不同赛题 Planner 的最大在途数。
# 名额从激活持有到本题 completed/skipped/failed，等待 Worker 时不释放。
CTF_PLANNER_CONCURRENCY=1
# 所有赛题共用的全局 Worker 池大小
WORKER_CONCURRENCY=3

# ---- pi 扩展与 MCP（四角色均可按角色配置）----
# 角色级 EXTENSIONS_<ROLE> 优先于全局 EXTENSIONS_ENABLED；未设置时继承全局值。
# 单服务器开关可在 .mcp.json 条目中设置 "disabled": true。
# EXTENSIONS_ENABLED=true
# EXTENSIONS_MANAGER=true
# EXTENSIONS_PLANNER=true
# EXTENSIONS_WORKER=true
# EXTENSIONS_COMPACTOR=true

# ---- Kali 工具环境（全部 Challenge 的 Worker 共用）----
# container 模式绑定 /work/task-<全局task_id>；embedded 模式绑定实际任务目录。
# false 时不提供 kali_bash，Worker 仅使用宿主机 bash。
KALI_ENABLED=true
KALI_IMAGE=kalilinux/kali-rolling
# 使用 npm run kali:image / kali:import 的预构建镜像时改为 param-kali-ctf
KALI_CONTAINER=kali
KALI_SKIP_PROVISION=false
KALI_PROVISION_TIMEOUT_MS=1800000
KALI_APT_MIRROR=http://mirror.nju.edu.cn/kali
KALI_INSTALL_PACKAGES=python3 python3-pip python3-dev libssl-dev libffi-dev build-essential cmake pkg-config pipx git radare2 gdb patchelf binwalk libimage-exiftool-perl steghide tshark zbar-tools python3-gmpy2 python3-sympy ruby ruby-rubygems curl telnet openssh-client vim tmux jq tree htop net-tools nmap sqlmap metasploit-framework dirsearch nuclei hydra john tcpdump python3-impacket impacket-scripts proxychains4 wireguard-tools openvpn iproute2 openresolv

# ---- PostgreSQL（开发模式为 docker compose 16-alpine；镜像内为本地 PG≥16）----
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=pentest
PGPASSWORD=pentest
PGDATABASE=pentest
# 可选：仅在 All-in-One 明确要求持久化 PGDATA 时设置为 /output/postgres-data。
# 日常续跑使用 history_db，不需要保存 PostgreSQL 数据目录。
# PARAM_PGDATA=/var/lib/postgresql/param-data

# ---- 按 Challenge 独立压缩（可选）----
COMPACTOR_ENABLED=false
COMPACTOR_FIRST_TRIGGER=40
COMPACTOR_TIMEOUT_MS=300000

# ---- 其他编排参数 ----
INSERT_TASK_MAX_CHARS=600
INSERT_TASK_MAX_NOTE_CHARS=200
POLL_INTERVAL_MS=500
MANAGER_TIMEOUT_MS=300000
PLANNER_TIMEOUT_MS=300000
WORKER_TIMEOUT_MS=900000
# 整场全局安全阀；0=不限制
GLOBAL_TIMEOUT_MS=3600000
